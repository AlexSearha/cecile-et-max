# Jeton du lien caché des mariés : https://votre-site/admin/<ADMIN_TOKEN>
# Générez-en un long et aléatoire, ex. : openssl rand -hex 24
ADMIN_TOKEN=changez-moi-avec-une-longue-chaine-aleatoire

# Dossier de stockage du fichier guests.json (optionnel, par défaut ./data)
# DATA_DIR=/app/data

# Stockage Redis (obligatoire sur Vercel). Ajouté automatiquement par l'intégration
# Upstash du Vercel Marketplace. Sans ces variables, stockage dans un fichier JSON.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
